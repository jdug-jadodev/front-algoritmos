---
/**
 * [slug].astro - Generador dinámico de páginas para cada algoritmo.
 *
 * Estrategia: delega TODO el chrome de la página (breadcrumb, header,
 * navegación prev/next) a `AlgoLayout`. Este archivo solo decide qué
 * contenido se pasa como slot:
 *   - Si el algoritmo tiene visualizador registrado → <Visualizer />
 *   - Si no → <ComingSoon />
 *
 * De esta forma, el header se renderiza UNA sola vez, evitando la
 * duplicación que existía cuando [slug].astro renderizaba su propio
 * header Y AlgoLayout (vía Visualizer) renderizaba otro.
 */

import AlgoLayout from '../../layouts/AlgoLayout.astro';
import Visualizer from '../../components/visualizer/Visualizer.astro';
import ComingSoon from '../../components/visualizer/ComingSoon.astro';
import algorithms from '../../data/algorithms.json';
import { hasVisualizer } from '../../lib/visualizers/registry';

export function getStaticPaths() {
  return algorithms.map((algo) => ({
    params: { slug: algo.id },
    props: { algo },
  }));
}

const { algo } = Astro.props;

// El registry es la fuente de verdad para "¿tiene visualizador?".
const showVisualizer = hasVisualizer(algo.id);
---

<AlgoLayout
  title={algo.name}
  algoId={algo.id}
  level={algo.level}
>
  {showVisualizer ? (
    <Visualizer algoId={algo.id} level={algo.level} />
  ) : (
    <ComingSoon algoId={algo.id} />
  )}
</AlgoLayout>
